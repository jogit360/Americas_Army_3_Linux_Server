# Build artifacts
build/
*.o
*.a
*.so
*.so.*

# Game asset mirror — populated by the operator from a legit AA3 install.
# Not redistributable; 1.2+ GB of cooked packages. Anchored with a leading
# slash so it only matches the top-level maps/, not config/maps/ which
# holds the small JSON manifest files.
/maps/

# Editor noise
*.swp
*.swo
.vscode/
.idea/
*~

# OS noise
.DS_Store
Thumbs.db

# Local-only config overrides
config/aa3_server.local.ini

# Legacy flat collision generated from cooked maps (dev tests only).
/data/collision/
# Map bundles: the shipped, lossless form is tracked (data/maps/<map>.aa3map.zst,
# checked 1:1 against an install with `aa3_mapbake --verify`); uncompressed
# local re-bakes (<map>.aa3map) stay out of git.
/data/maps/*.aa3map

# Runtime stats export
/stats/
